{
  "name": "safemark",
  "version": "1.0.0",
  "private": true,
  "description": "Add watermarks to images and PDFs entirely in your browser. Files never leave your device.",
  "keywords": [
    "watermark",
    "pdf",
    "image",
    "privacy",
    "offline",
    "client-side",
    "vue"
  ],
  "homepage": "https://shenyizg.github.io/safemark/",
  "bugs": {
    "url": "https://github.com/shenyizg/safemark/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenyizg/safemark.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
